# Refresh behavior
AUTO_REFRESH_ON_START=1
REFRESH_INTERVAL_MINUTES=60
AUTO_WRITE_WEEKLY_BRIEF=0
AUTO_WRITE_WEEKLY_BRIEF_ARCHIVE=1
AUTO_POST_WEEKLY_BRIEF=0
WEEKLY_BRIEF_DAYS=7
WEEKLY_BRIEF_TOP_LIMIT=5
WEEKLY_BRIEF_JSON_PATH=/Users/naoya/world-ai-curation/data/weekly_brief_latest.json
WEEKLY_BRIEF_MD_PATH=/Users/naoya/world-ai-curation/data/weekly_brief_latest.md
WEEKLY_BRIEF_ARCHIVE_DIR=/Users/naoya/world-ai-curation/data/weekly_briefs
WEEKLY_BRIEF_HISTORY_PATH=/Users/naoya/world-ai-curation/data/weekly_brief_history.json
WEEKLY_BRIEF_HISTORY_MAX_ENTRIES=200
SLACK_WEBHOOK_URL=
NOTION_API_TOKEN=
NOTION_PAGE_ID=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/world_ai_curation
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
PUBLIC_BASE_URL=http://127.0.0.1:8000
AFFILIATE_LINKS_PATH=/Users/naoya/world-ai-curation/config/affiliate_links.json
AFFILIATE_LINKS_JSON=
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_BIN=

# Optional X ingestion
X_BEARER_TOKEN=
X_SEARCH_QUERIES="AI OR LLM (release OR launch OR benchmark) -is:retweet lang:en||(agents OR coding assistant) (api OR sdk OR github) -is:retweet lang:en"
TIER_C_SOURCE_LIMIT=4
X_HTTP_TIMEOUT_SECONDS=15
RSS_HTTP_TIMEOUT_SECONDS=20

# Optional LLM enrichment
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_HTTP_TIMEOUT_SECONDS=30
APP_PYTHON=
APP_STATUS_URL=http://127.0.0.1:8000/api/status
HEALTH_MAX_STALE_MINUTES=180
HEALTH_MIN_CARD_COUNT=1
HEALTH_ALERT_SLACK=1
BACKUP_DIR=/Users/naoya/world-ai-curation/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_DATA_DIR=1
BACKUP_INCLUDE_PG=1
BACKUP_PG_DOCKER_CONTAINER=world-ai-curation-postgres
BACKUP_PG_DB_USER=postgres
BACKUP_PG_DB_NAME=world_ai_curation
BACKUP_DAILY_HOUR=3
BACKUP_DAILY_MINUTE=15
